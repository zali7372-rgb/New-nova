<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network for RemoteAIProvider / SearchSkill -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for background listening (Android 9+ requires the type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notification for the foreground listening service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Used only to query which apps are installed so NOVA can launch them.
         Required on Android 11+ (API 30+) to see the full app list. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".NovaApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nova"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nova">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.memory.MemoryActivity"
            android:exported="false"
            android:label="@string/memory_title"
            android:parentActivityName=".ui.settings.SettingsActivity" />

        <activity
            android:name=".ui.aliases.AliasManagerActivity"
            android:exported="false"
            android:label="@string/aliases_title"
            android:parentActivityName=".ui.settings.SettingsActivity" />

        <activity
            android:name=".ui.laptop.LaptopPairingActivity"
            android:exported="false"
            android:label="@string/laptop_pairing_title"
            android:parentActivityName=".ui.settings.SettingsActivity" />

        <service
            android:name=".service.NovaListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
