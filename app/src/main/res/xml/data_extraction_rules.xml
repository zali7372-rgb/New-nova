<?xml version="1.0" encoding="utf-8"?>
<!--
    NOVA stores conversation memory locally in a Room database. We deliberately
    exclude it from any backup/transfer mechanism so a user's personal memories
    never leave the device via cloud backup, even if backup is enabled later.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="database" path="nova_memory.db" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="nova_memory.db" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
