<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/laptop_pairing_intro"
            android:textColor="@color/nova_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_nova"
            android:padding="12dp"
            android:textColor="@color/nova_accent"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            tools:text="Nincs kapcsolat"
            xmlns:tools="http://schemas.android.com/tools" />

        <EditText
            android:id="@+id/inputIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/laptop_pairing_ip_hint"
            android:inputType="text"
            android:textColor="@color/nova_text_primary"
            android:textColorHint="@color/nova_text_secondary" />

        <EditText
            android:id="@+id/inputPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/laptop_pairing_port_hint"
            android:inputType="number"
            android:textColor="@color/nova_text_primary"
            android:textColorHint="@color/nova_text_secondary" />

        <EditText
            android:id="@+id/inputPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/laptop_pairing_pin_hint"
            android:inputType="number"
            android:textColor="@color/nova_text_primary"
            android:textColorHint="@color/nova_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/laptop_pairing_connect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/nova_error"
                android:enabled="false"
                android:text="@string/laptop_pairing_disconnect" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/nova_border"
            android:layout_marginVertical="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/laptop_pairing_route_toggle"
                android:textColor="@color/nova_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLaptopMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/laptop_pairing_route_toggle_summary"
            android:textColor="@color/nova_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/laptop_pairing_mic_toggle"
                android:textColor="@color/nova_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMicStreaming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/laptop_pairing_mic_toggle_summary"
            android:textColor="@color/nova_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</ScrollView>
