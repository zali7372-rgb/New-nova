<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bubble_nova"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/textCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_accent"
        android:textSize="11sp"
        android:layout_marginEnd="8dp"
        tools:text="FACT"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/textContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/nova_text_primary"
        android:textSize="14sp"
        tools:text="Szereti az angol zenét"
        xmlns:tools="http://schemas.android.com/tools" />

    <ImageButton
        android:id="@+id/buttonDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/memory_delete_one"
        android:src="@drawable/ic_delete"
        app:tint="@color/nova_text_secondary"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
