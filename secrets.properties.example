# Copy this file to "secrets.properties" (same folder, project root) and fill
# in your own values if you want NOVA's RemoteAIProvider to be usable.
#
# secrets.properties is listed in .gitignore and will NEVER be committed.
# NOVA works fully offline / without this file via LocalAIProvider.
#
# NOVA_REMOTE_AI_API_KEY=your-api-key-here
# NOVA_REMOTE_AI_ENDPOINT=https://api.anthropic.com/v1/messages
